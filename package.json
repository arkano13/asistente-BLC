{
  "name": "asistente-blc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "node dist/scripts/cargar-empresa.js blc --si-vacio",
    "start:gateway": "node dist/src/gateway/index.js",
    "start:core": "node dist/src/core.js",
    "dev:gateway": "tsx watch src/gateway/index.ts",
    "dev:core": "tsx watch src/core.ts",
    "test": "node --test dist/test/",
    "cargar-empresa": "node dist/scripts/cargar-empresa.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "baileys": "7.0.0-rc14",
    "bullmq": "^6.7.10",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
